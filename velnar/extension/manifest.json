{
  "manifest_version": 3,
  "name": "NEXORA - Customize Your GitHub",
  "short_name": "NEXORA",
  "version": "2.5.0",
  "description": "Make GitHub yours with 48 static themes, custom palettes and typography. Lightweight and private by design.",
  "author": "NEXORA",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "NEXORA — GitHub Studio",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*"
  ],
  "commands": {
    "toggle-extension": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Toggle NEXORA"
    },
    "random-theme": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Choose a random theme"
    },
    "toggle-review-focus": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Toggle focus on pull request changes"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "run_at": "document_start",
      "js": [
        "utils/constants.js",
        "themes/presets.js",
        "utils/validator.js",
        "utils/storage.js",
        "content/injector.js",
        "content/observer.js",
        "content/content.js"
      ]
    }
  ],
  "minimum_chrome_version": "111"
}
